{
  "name": "poe2-price-checker",
  "productName": "PoE 2 Price Checker",
  "version": "0.3.146",
  "description": "Оверлей для оценки предметов Path of Exile 2 по горячей клавише",
  "main": "src/main/main.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "dist": "electron-builder --win nsis",
    "release": "node scripts/release.js",
    "collect-weights": "node scripts/collect-weights.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.3",
    "uiohook-napi": "^1.5.5"
  },
  "author": "PoE 2 Price Checker",
  "build": {
    "appId": "local.poe2.pricechecker",
    "productName": "PoE 2 Price Checker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "data/**/*",
      "!data/*.partial.json",
      "!data/*.log",
      "!assets/icon.ico",
      "!node_modules/uiohook-napi/{libuiohook,src}/**",
      "!node_modules/uiohook-napi/prebuilds/{darwin-*,linux-*,win32-arm64}/**",
      "!**/*.{map,d.ts}"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PoE 2 Price Checker",
      "artifactName": "PoE-2-Price-Checker-Setup-${version}.${ext}"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "zhurauljou",
        "repo": "poe2-advanced-price-check"
      }
    ]
  },
  "repository": "https://github.com/zhurauljou/poe2-advanced-price-check"
}

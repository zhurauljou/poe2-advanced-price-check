{
  "name": "poe2-price-checker",
  "productName": "PoE 2 Price Checker",
  "version": "0.2.9",
  "description": "Оверлей для оценки предметов Path of Exile 2 по горячей клавише",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.3",
    "uiohook-napi": "^1.5.5"
  },
  "author": "PoE 2 Price Checker",
  "build": {
    "appId": "local.poe2.pricechecker",
    "productName": "PoE 2 Price Checker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PoE 2 Price Checker",
      "artifactName": "PoE-2-Price-Checker-Setup-${version}.${ext}"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "zhurauljou",
        "repo": "poe2-advanced-price-check"
      }
    ]
  },
  "repository": "https://github.com/zhurauljou/poe2-advanced-price-check"
}
